---
import "../../public/styles/global.css";

const { title = "DevTask" } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta
      name="google-site-verification"
      content="08kXt2Gl_B6ZKkkxGaSG5UOssgLzyKYniMpVddLPfZc"
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#11131c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="DevTask" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="description" content="DevTask" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.loadingDelay = "true";

      try {
        const dashboardPath =
          location.pathname.replace(/index\.html$/, "") || "/";

        if (
          dashboardPath === "/" &&
          sessionStorage.getItem("devtask-page-cache:/")
        ) {
          document.documentElement.dataset.dashboardCached = "true";
        }
      } catch (error) {
        console.warn("Could not check the cached dashboard.", error);
      }
    </script>
    <style is:inline>
      html[data-loading-delay="true"] .loading-placeholder {
        visibility: hidden;
      }

      html[data-dashboard-cached="true"] #dashboard-loading {
        display: none !important;
      }
    </style>
  </head>

  <body>
    <slot />
    <script is:inline>
      window.setTimeout(() => {
        document.documentElement.removeAttribute("data-loading-delay");
      }, 300);

      (() => {
        const cachePrefix = "devtask-page-cache:";
        const page = document.querySelector("[data-page-cache]");
        const cachePath = location.pathname.replace(/index\.html$/, "") || "/";
        const cacheKey = `${cachePrefix}${cachePath}${location.search}`;

        if (page) {
          try {
            const cachedMarkup = sessionStorage.getItem(cacheKey);

            if (cachedMarkup) {
              page.innerHTML = cachedMarkup;
              page.dataset.pageCacheRestored = "true";
              page.removeAttribute("aria-busy");

              const dashboardShell =
                document.querySelector<HTMLElement>("#dashboard-shell");
              const dashboardLoading =
                document.querySelector<HTMLElement>("#dashboard-loading");

              if (dashboardShell && dashboardLoading) {
                dashboardShell.hidden = false;
                dashboardLoading.hidden = true;
              }
            } else if (cachePath === "/") {
              document.documentElement.removeAttribute("data-dashboard-cached");
            }

            const cacheCurrentPage = () => {
              const openDialog = page.querySelector(
                '[role="dialog"]:not([hidden])',
              );

              if (
                page.closest("[hidden]") ||
                page.querySelector(
                  ".loading, .loading-state, .task-loading, [aria-busy='true']",
                ) ||
                (openDialog && !openDialog.closest("[hidden]"))
              ) {
                return;
              }

              try {
                page
                  .querySelectorAll("input, textarea, select")
                  .forEach((field) => {
                    if (field instanceof HTMLInputElement) {
                      if (field.type === "checkbox" || field.type === "radio") {
                        field.toggleAttribute("checked", field.checked);
                      } else if (
                        field.type !== "password" &&
                        field.type !== "file"
                      ) {
                        field.setAttribute("value", field.value);
                      }
                    } else if (field instanceof HTMLTextAreaElement) {
                      field.textContent = field.value;
                    } else if (field instanceof HTMLSelectElement) {
                      field.querySelectorAll("option").forEach((option) => {
                        option.toggleAttribute("selected", option.selected);
                      });
                    }
                  });

                sessionStorage.setItem(cacheKey, page.innerHTML);
              } catch (error) {
                console.warn("Could not cache the current page.", error);
              }
            };

            window.addEventListener("devtask:cache-current-page", cacheCurrentPage);
            window.addEventListener("pagehide", cacheCurrentPage);

            document.addEventListener(
              "click",
              (event) => {
                if (
                  event.defaultPrevented ||
                  !(event.target instanceof Element) ||
                  (event instanceof MouseEvent &&
                    (event.button !== 0 ||
                      event.metaKey ||
                      event.ctrlKey ||
                      event.shiftKey ||
                      event.altKey))
                ) {
                  return;
                }

                const link = event.target.closest<HTMLAnchorElement>("a[href]");
                if (
                  !link ||
                  link.hasAttribute("download") ||
                  (link.target && link.target !== "_self")
                ) {
                  return;
                }

                const destination = new URL(link.href, window.location.href);
                if (destination.origin === window.location.origin) {
                  cacheCurrentPage();
                }
              },
              true,
            );
          } catch (error) {
            console.warn("Could not restore the cached page.", error);
          }
        }

        window.addEventListener("devtask:clear-page-cache", () => {
          try {
            for (let index = sessionStorage.length - 1; index >= 0; index--) {
              const key = sessionStorage.key(index);

              if (key?.startsWith(cachePrefix)) {
                sessionStorage.removeItem(key);
              }
            }
          } catch (error) {
            console.warn("Could not clear cached pages.", error);
          }
        });
      })();
    </script>
  </body>
</html>
