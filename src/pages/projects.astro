---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
---

<BaseLayout title="DevTask — Projects">
    <Sidebar />

    <main class="dashboard projects-page" data-page-cache>
        <header class="page-header">
            <div>
                <p class="eyebrow">YOUR WORKSPACE</p>
                <h1>Projects<span>.</span></h1>
                <p class="page-description">
                Organize your work and keep every task in the right place.
                </p>
            </div>

            <button class="primary-button" id="create-project-button">
                <span>+</span> New project
            </button>
        </header>

        <section class="projects-toolbar">
            <div>
                <h2>All projects</h2>
                <p id="projects-count" class="loading-placeholder">Loading projects...</p>
            </div>

            <input
                id="project-search"
                type="search"
                placeholder="Search projects..."
                aria-label="Search projects"
            />
        </section>

        <div id="projects-message" class="projects-message loading-placeholder" role="status">
            Loading projects...
        </div>

        <section id="projects-grid" class="projects-grid" aria-label="Project list"></section>
    </main>

    <div class="project-modal" id="project-modal" hidden>
        <div class="project-modal-backdrop" data-close-modal></div>

        <section
            class="project-modal-content"
            role="dialog"
            aria-modal="true"
            aria-labelledby="project-modal-title"
        >
            <header class="modal-header">
                <div>
                <p class="eyebrow">PROJECT DETAILS</p>
                <h2 id="project-modal-title">Create project</h2>
                </div>
                <button
                type="button"
                class="close-button"
                data-close-modal
                aria-label="Close dialog"
                >×</button>
            </header>

            <form id="project-form">
                <label for="project-name-input">Project name</label>
                <input
                id="project-name-input"
                name="name"
                type="text"
                placeholder="e.g. DevTask"
                maxlength="60"
                required
                />

                <label for="project-description-input">Description <span>(optional)</span></label>
                <textarea
                id="project-description-input"
                name="description"
                rows="4"
                maxlength="500"
                placeholder="What is this project about?"
                ></textarea>

                <p id="project-form-error" class="form-error" role="alert" hidden></p>

                <footer class="modal-actions">
                <button type="button" class="secondary-button" data-close-modal>
                    Cancel
                </button>
                <button type="submit" class="primary-button" id="save-project-button">
                    Save project
                </button>
                </footer>
            </form>
        </section>
    </div>

    <script>
        import { supabase } from "../lib/supabase.js";
        import { navigateTo } from "../lib/navigation.js";

        type Project = {
        id: string;
        name: string;
        description: string | null;
        created_at: string;
        taskCount: number;
        };

        document.addEventListener("DOMContentLoaded", async () => {
        const grid = document.querySelector<HTMLElement>("#projects-grid");
        const message = document.querySelector<HTMLElement>("#projects-message");
        const countLabel = document.querySelector<HTMLElement>("#projects-count");
        const searchInput = document.querySelector<HTMLInputElement>("#project-search");
        const modal = document.querySelector<HTMLElement>("#project-modal");
        const form = document.querySelector<HTMLFormElement>("#project-form");
        const nameInput = document.querySelector<HTMLInputElement>("#project-name-input");
        const descriptionInput = document.querySelector<HTMLTextAreaElement>(
            "#project-description-input",
        );
        const modalTitle = document.querySelector<HTMLElement>("#project-modal-title");
        const formError = document.querySelector<HTMLElement>("#project-form-error");
        const saveButton = document.querySelector<HTMLButtonElement>("#save-project-button");
        const createButton = document.querySelector<HTMLButtonElement>("#create-project-button");

        if (
            !grid || !message || !countLabel || !searchInput || !modal ||
            !form || !nameInput || !descriptionInput || !modalTitle ||
            !formError || !saveButton || !createButton
        ) {
            return;
        }

        let projects: Project[] = [];
        let editingProjectId: string | null = null;
        let saving = false;

        const showProjectDialog = (
            title: string,
            description: string,
            options: { confirmLabel?: string; showCancel?: boolean } = {},
        ): Promise<boolean> => {
            return new Promise((resolve) => {
                const showCancel = options.showCancel ?? true;
                const overlay = document.createElement("div");
                overlay.className = "delete-modal-overlay";

                const dialog = document.createElement("section");
                dialog.className = "delete-modal";
                dialog.setAttribute("role", "alertdialog");
                dialog.setAttribute("aria-modal", "true");

                const icon = document.createElement("div");
                icon.className = "delete-modal-icon";
                icon.textContent = showCancel ? "!" : "×";

                const heading = document.createElement("h2");
                heading.textContent = title;

                const messageText = document.createElement("p");
                messageText.textContent = description;

                const actions = document.createElement("div");
                actions.className = "delete-modal-actions";

                let cancelButton: HTMLButtonElement | null = null;

                if (showCancel) {
                    cancelButton = document.createElement("button");
                    cancelButton.type = "button";
                    cancelButton.className = "delete-modal-cancel";
                    cancelButton.textContent = "Cancel";
                    actions.append(cancelButton);
                }

                const confirmButton = document.createElement("button");
                confirmButton.type = "button";
                confirmButton.className = showCancel
                    ? "delete-modal-confirm"
                    : "delete-modal-ok";
                confirmButton.textContent =
                    options.confirmLabel ?? (showCancel ? "Delete Project" : "OK");

                actions.append(confirmButton);
                dialog.append(icon, heading, messageText, actions);
                overlay.append(dialog);
                document.body.append(overlay);
                document.body.classList.add("modal-open");

                let finished = false;

                const close = (confirmed: boolean) => {
                    if (finished) return;
                    finished = true;

                    document.removeEventListener("keydown", onKeyDown);
                    overlay.remove();
                    document.body.classList.remove("modal-open");
                    resolve(confirmed);
                };

                const onKeyDown = (event: KeyboardEvent) => {
                    if (event.key === "Escape") close(false);
                };

                cancelButton?.addEventListener("click", () => close(false));
                confirmButton.addEventListener("click", () => close(true));

                overlay.addEventListener("click", (event) => {
                    if (event.target === overlay) close(false);
                });

                document.addEventListener("keydown", onKeyDown);
                (cancelButton ?? confirmButton).focus();
            });
        };

        const escapeHtml = (value: string): string =>
            value.replace(/[&<>"']/g, (character) => {
            const entities: Record<string, string> = {
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;",
            };
            return entities[character];
            });

        const formatDate = (date: string): string => {
            const parsed = new Date(date);
            if (Number.isNaN(parsed.getTime())) return "Unknown date";

            return new Intl.DateTimeFormat("id-ID", {
            day: "numeric",
            month: "short",
            year: "numeric",
            }).format(parsed);
        };

        const openModal = (project?: Project) => {
            editingProjectId = project?.id ?? null;
            modalTitle.textContent = project ? "Edit project" : "Create project";
            saveButton.textContent = project ? "Save changes" : "Create project";
            nameInput.value = project?.name ?? "";
            descriptionInput.value = project?.description ?? "";
            formError.hidden = true;
            formError.textContent = "";
            modal.hidden = false;
            document.body.classList.add("modal-open");
            nameInput.focus();
        };

        const closeModal = () => {
            if (saving) return;
            modal.hidden = true;
            document.body.classList.remove("modal-open");
            form.reset();
            formError.hidden = true;
        };

        const renderProjects = () => {
            const query = searchInput.value.trim().toLowerCase();

            const filtered = projects.filter((project) =>
            project.name.toLowerCase().includes(query) ||
            (project.description ?? "").toLowerCase().includes(query),
            );

            countLabel.textContent =
            `${projects.length} ${projects.length === 1 ? "project" : "projects"}`;
            countLabel.classList.remove("loading-placeholder");
            message.classList.remove("loading-placeholder");

            if (filtered.length === 0) {
            grid.innerHTML = "";
            message.hidden = false;
            message.textContent = projects.length === 0
                ? "No projects yet. Create your first project to get started."
                : "No projects match your search.";
            return;
            }

            message.hidden = true;

            grid.innerHTML = filtered.map((project) => `
            <article class="project-card" data-project-id="${escapeHtml(project.id)}">
                <div class="project-card-top">
                <div class="project-icon" aria-hidden="true">◫</div>
                <div class="project-menu">
                    <button
                        type="button"
                        class="project-action"
                        data-action="edit"
                        data-id="${escapeHtml(project.id)}"
                        aria-label="Edit ${escapeHtml(project.name)}"
                    >Edit</button>
                    <button
                        type="button"
                        class="project-action delete-action"
                        data-action="delete"
                        data-id="${escapeHtml(project.id)}"
                        aria-label="Delete ${escapeHtml(project.name)}"
                    >Delete</button>
                </div>
                </div>

                <h3>${escapeHtml(project.name)}</h3>
                <p class="project-description">${
                    escapeHtml(project.description?.trim() || "No description provided.")
                }</p>

                <div class="project-card-bottom">
                <span class="task-count">
                    <span aria-hidden="true">☑</span>
                    ${project.taskCount} ${project.taskCount === 1 ? "task" : "tasks"}
                </span>
                <span class="project-date">${formatDate(project.created_at)}</span>
                </div>
            </article>
            `).join("");
        };

        const loadProjects = async () => {
            if (document.querySelector("main[data-page-cache]")?.dataset.pageCacheRestored !== "true") {
                message.hidden = false;
                message.textContent = "Loading projects...";
                grid.innerHTML = "";
            }

            const { data: projectRows, error: projectError } = await supabase
            .from("projects")
            .select("id, name, description, created_at")
            .order("created_at", { ascending: false });

            if (projectError) {
            message.textContent = `Failed to load projects: ${projectError.message}`;
            message.classList.remove("loading-placeholder");
            countLabel.textContent = "Unable to load projects";
            countLabel.classList.remove("loading-placeholder");
            return;
            }

            const { data: taskRows, error: taskError } = await supabase
            .from("tasks")
            .select("project_id")
            .not("project_id", "is", null);

            if (taskError) {
            message.textContent = `Failed to load task counts: ${taskError.message}`;
            message.classList.remove("loading-placeholder");
            countLabel.textContent = "Unable to load projects";
            countLabel.classList.remove("loading-placeholder");
            return;
            }

            const taskCounts = new Map<string, number>();

            for (const task of taskRows ?? []) {
            if (task.project_id) {
                taskCounts.set(
                task.project_id,
                (taskCounts.get(task.project_id) ?? 0) + 1,
                );
            }
            }

            projects = (projectRows ?? []).map((project) => ({
            ...project,
            taskCount: taskCounts.get(project.id) ?? 0,
            }));

            renderProjects();
        };

        createButton.addEventListener("click", () => openModal());

        modal.querySelectorAll("[data-close-modal]").forEach((element) => {
            element.addEventListener("click", closeModal);
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && !modal.hidden) closeModal();
        });

        searchInput.addEventListener("input", renderProjects);

        grid.addEventListener("click", async (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const button = target.closest<HTMLButtonElement>("[data-action]");

            if (!button) {
                const card = target.closest<HTMLElement>(".project-card");
                const projectId = card?.dataset.projectId;

                if (projectId && grid.contains(card)) {
                    navigateTo(`/project/?id=${encodeURIComponent(projectId)}`);
                }

                return;
            }

            const projectId = button.dataset.id;
            const action = button.dataset.action;
            const project = projects.find((item) => item.id === projectId);

            if (!project) return;

            if (action === "edit") {
            openModal(project);
            return;
            }

            if (action === "delete") {
                const confirmed = await showProjectDialog(
                    "Delete this project?",
                    `The project "${project.name}" and all associated tasks will be permanently deleted. This action cannot be undone.`,
                    { confirmLabel: "Delete Project" },
                );

                if (!confirmed) return;

                button.disabled = true;

                const { error } = await supabase
                    .from("projects")
                    .delete()
                    .eq("id", project.id);

                if (error) {
                    button.disabled = false;

                    await showProjectDialog(
                        "Failed to delete project",
                        `Something went wrong while deleting this project: ${error.message}`,
                        { confirmLabel: "Got it", showCancel: false },
                    );

                    return;
                }

                await loadProjects();
            }
        });

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (saving) return;

            const name = nameInput.value.trim();
            const description = descriptionInput.value.trim();

            if (!name) {
            formError.textContent = "Nama proyek wajib diisi.";
            formError.hidden = false;
            nameInput.focus();
            return;
            }

            saving = true;
            saveButton.disabled = true;
            saveButton.textContent = "Saving...";
            formError.hidden = true;

            const result = editingProjectId
            ? await supabase
                .from("projects")
                .update({ name, description })
                .eq("id", editingProjectId)
            : await supabase
                .from("projects")
                .insert({ name, description });

            saving = false;
            saveButton.disabled = false;
            saveButton.textContent = editingProjectId
            ? "Save changes"
            : "Create project";

            if (result.error) {
            formError.textContent = result.error.message.includes("projects_user_name_unique")
                ? "Nama proyek ini sudah digunakan. Gunakan nama lain."
                : `Gagal menyimpan proyek: ${result.error.message}`;
            formError.hidden = false;
            return;
            }

            closeModal();
            await loadProjects();
        });

        const { data, error } = await supabase.auth.getSession();

        if (error || !data.session) {
            navigateTo("/login/", true);
            return;
        }

        await loadProjects();

        supabase.auth.onAuthStateChange((event) => {
            if (event === "SIGNED_OUT") {
            navigateTo("/login/", true);
            }
        });
        });
    </script>

    <style is:global>
        .projects-page {
            box-sizing: border-box;
            min-height: 100vh;
            min-width: 0;
            margin-left: 250px;
            padding: 42px 40px;
            color: #e8eaf0;
        }

        .projects-page * {
            box-sizing: border-box;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 24px;
            margin-bottom: 38px;
        }

        .eyebrow {
            margin: 0 0 10px;
            color: #9990ed;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.6px;
        }

        .page-header h1 {
            margin: 0;
            color: #f0f1f7;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: clamp(30px, 4vw, 40px);
            font-weight: 800;
            letter-spacing: -2px;
        }

        .page-header h1 span {
            color: #9b8dff;
        }

        .page-description {
            margin: 12px 0 0;
            color: #969bad;
            font-size: 14px;
            line-height: 1.7;
        }

        .primary-button,
        .secondary-button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            min-height: 42px;
            padding: 0 17px;
            border: 1px solid transparent;
            border-radius: 9px;
            font: inherit;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s;
        }

        .primary-button {
            color: white;
            background: #7969e9;
        }

        .primary-button:hover {
            background: #8b7cff;
        }

        .primary-button:disabled {
            opacity: 0.6;
            cursor: wait;
        }

        .primary-button > span {
            font-size: 20px;
            line-height: 1;
        }

        .secondary-button {
            color: #d4d7e2;
            background: #1a1e2a;
            border-color: #303548;
        }

        .secondary-button:hover {
            background: #252a39;
        }

        .projects-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .projects-toolbar h2 {
            margin: 0;
            color: #e8eaf0;
            font-size: 17px;
        }

        .projects-toolbar p {
            margin: 6px 0 0;
            color: #8e94a8;
            font-size: 12px;
        }

        #project-search {
            width: min(280px, 100%);
            min-height: 40px;
            padding: 0 13px;
            color: #e8eaf0;
            background: #131620;
            border: 1px solid #292e3d;
            border-radius: 9px;
            outline: none;
            font: inherit;
            font-size: 13px;
        }

        #project-search:focus,
        #project-form input:focus,
        #project-form textarea:focus {
            border-color: #7969e9;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .project-card {
            min-width: 0;
            padding: 21px;
            background: #131620;
            border: 1px solid #292e3d;
            border-radius: 13px;
            transition: border-color 0.2s, transform 0.2s;
            cursor: pointer;
        }

        .project-card:hover {
            border-color: #484064;
            transform: translateY(-2px);
        }

        .project-card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
        }

        .project-icon {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 43px;
            height: 43px;
            color: #b8aaff;
            background: #28213f;
            border: 1px solid #413563;
            border-radius: 11px;
            font-size: 24px;
        }

        .project-menu {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .project-action {
            padding: 6px 8px;
            color: #aab0c4;
            background: transparent;
            border: 1px solid #303548;
            border-radius: 6px;
            font: inherit;
            font-size: 11px;
            cursor: pointer;
        }

        .project-action:hover {
            color: white;
            background: #242838;
        }

        .project-action:disabled {
            opacity: 0.5;
            cursor: wait;
        }

        .delete-action:hover {
            color: #ff9b9b;
            border-color: #77444d;
        }

        .project-card h3 {
            overflow-wrap: anywhere;
            margin: 0 0 9px;
            color: #e8eaf0;
            font-size: 17px;
            font-weight: 650;
        }

        .project-description {
            display: -webkit-box;
            overflow: hidden;
            min-height: 42px;
            margin: 0;
            color: #969bad;
            font-size: 12px;
            line-height: 1.7;
            overflow-wrap: anywhere;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .project-card-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 23px;
            padding-top: 15px;
            border-top: 1px solid #292e3d;
        }

        .task-count,
        .project-date {
            color: #a0a6b8;
            font-size: 11px;
        }

        .task-count span {
            margin-right: 4px;
            color: #a99aff;
        }

        .projects-message {
            padding: 36px 20px;
            color: #969bad;
            background: #131620;
            border: 1px dashed #303548;
            border-radius: 12px;
            font-size: 13px;
            line-height: 1.7;
            text-align: center;
        }

        .projects-message[hidden],
        .project-modal[hidden] {
            display: none;
        }

        .project-modal {
            position: fixed;
            z-index: 1000;
            inset: 0;
            display: grid;
            place-items: center;
            padding: 20px;
        }

        .project-modal-backdrop {
            position: absolute;
            inset: 0;
            background: rgb(4 5 10 / 75%);
            backdrop-filter: blur(5px);
        }

        .project-modal-content {
            position: relative;
            z-index: 1;
            width: min(100%, 480px);
            max-height: calc(100vh - 40px);
            overflow-y: auto;
            padding: 26px;
            background: #131620;
            border: 1px solid #303548;
            border-radius: 15px;
            box-shadow: 0 25px 80px rgb(0 0 0 / 40%);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 25px;
        }

        .modal-header h2 {
            margin: 0;
            color: #f0f1f7;
            font-size: 23px;
        }

        .close-button {
            flex-shrink: 0;
            width: 32px;
            height: 32px;
            color: #aab0c4;
            background: #1d2130;
            border: 1px solid #303548;
            border-radius: 8px;
            font-size: 22px;
            cursor: pointer;
        }

        #project-form {
            display: grid;
            gap: 10px;
        }

        #project-form label {
            margin-top: 8px;
            color: #dfe1eb;
            font-size: 12px;
            font-weight: 600;
        }

        #project-form label span {
            color: #858ba0;
            font-weight: 400;
        }

        #project-form input,
        #project-form textarea {
            width: 100%;
            padding: 12px;
            color: #e8eaf0;
            background: #0e1119;
            border: 1px solid #303548;
            border-radius: 8px;
            outline: none;
            font: inherit;
            font-size: 13px;
            resize: vertical;
        }

        #project-form input {
            min-height: 42px;
        }

        #project-form textarea {
            min-height: 90px;
        }

        .form-error {
            margin: 5px 0 0;
            color: #ff9b9b;
            font-size: 12px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .form-error[hidden] {
            display: none;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 18px;
        }

        body.modal-open {
            overflow: hidden;
        }

        @media (max-width: 1150px) {
            .projects-page {
                padding: 35px 25px;
            }

            .projects-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 760px) {
            .projects-page {
                margin-left: 0;
                padding: 30px 20px;
            }

            .page-header {
                align-items: flex-start;
            }

            .projects-toolbar {
                align-items: stretch;
                flex-direction: column;
                gap: 15px;
            }

            #project-search {
                width: 100%;
            }

            .projects-grid {
                grid-template-columns: minmax(0, 1fr);
            }

            .project-modal-content {
                padding: 21px;
            }
        }

        @media (max-width: 480px) {
            .page-header {
                flex-direction: column;
                gap: 20px;
                margin-bottom: 30px;
            }

            .project-card {
                padding: 16px;
            }

            .project-modal-content {
                padding: 20px;
            }
        }
        
        .delete-modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgb(5 6 12 / 75%);
            backdrop-filter: blur(6px);
