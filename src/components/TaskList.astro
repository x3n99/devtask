<section class="task-panel" id="tasks">
    <header class="task-header">
        <div>
        <h2>Recent tasks</h2>
        <p>Manage and track your latest work.</p>
        </div>

        <button class="view-all" id="task-count" type="button">
        0 tasks
        </button>
    </header>
    <div class="task-toolbar">
        <div class="task-search">
            <span aria-hidden="true">⌕</span>
            <input
                type="search"
                id="task-search"
                placeholder="Search tasks..."
                aria-label="Search tasks"
            />
        </div>

        <select id="task-status-filter" aria-label="Filter by status">
            <option value="all">All statuses</option>
            <option value="in-progress">In Progress</option>
            <option value="completed">Completed</option>
        </select>

        <select id="task-priority-filter" aria-label="Filter by priority">
            <option value="all">All priorities</option>
            <option value="high">High Priority</option>
            <option value="medium">Medium Priority</option>
            <option value="low">Low Priority</option>
        </select>
    </div>

    <div class="task-table">
        <div class="task-table-header">
        <span>Task name</span>
        <span>Priority</span>
        <span>Due date</span>
        <span></span>
        </div>

        <div id="task-list">
        <p class="task-loading">Loading tasks...</p>
        </div>
    </div>

    <footer class="task-footer">
        <span id="task-summary">Your tasks will appear here.</span>
    </footer>
</section>

