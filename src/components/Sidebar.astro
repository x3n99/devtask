---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentSection =
  currentPath === "/tasks"
    ? "Tasks"
    : currentPath === "/projects" || currentPath === "/project"
      ? "Projects"
      : currentPath === "/calendar"
        ? "Calendar"
        : currentPath === "/profile"
          ? "Profile"
          : "Overview";
---

<header class="mobile-app-header">
  <a class="mobile-brand" href="/">
    <span class="mobile-brand-icon">D</span>
    <span>DevTask</span>
  </a>
  <span class="mobile-page-title">{currentSection}</span>
</header>

<aside class="sidebar" id="devtask-sidebar">
  <a href="/" class="brand">
    <span class="brand-icon">D</span>
    <span class="brand-name">devtask<span>.</span></span>
  </a>

  <div class="nav-section">
    <p class="nav-label">WORKSPACE</p>

    <nav class="navigation" aria-label="Primary navigation">
      <a
        href="/"
        class={`nav-item ${currentPath === "/" ? "active" : ""}`}
      >
        <span class="nav-icon">▦</span>
        <span>Overview</span>
      </a>

      <a href="/tasks/" class="nav-item">
        <span class="nav-icon">☑</span>
        <span>My Tasks</span>
      </a>

      <a
        href="/projects/"
        class={`nav-item ${currentPath === "/projects" ? "active" : ""}`}
      >
        <span class="nav-icon">◫</span>
        <span>Projects</span>
      </a>

      <a href="/calendar/" class="nav-item">
        <span class="nav-icon">▦</span>
        <span>Calendar</span>
      </a>
    </nav>
  </div>

  <a
    href="/profile/"
    class={`sidebar-bottom ${currentPath === "/profile" ? "profile-active" : ""}`}
    aria-label="Open profile"
  >
    <div class="user-avatar" id="user-avatar">U</div>

    <div class="user-info">
      <strong id="user-name">Loading...</strong>
    </div>
  </a>
</aside>

<nav class="mobile-bottom-nav" aria-label="Primary navigation">
  <a
    class:list={["mobile-nav-item", currentPath === "/" && "active"]}
    href="/"
    aria-current={currentPath === "/" ? "page" : undefined}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
      <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
    </svg>
    <span>Home</span>
  </a>
  <a
    class:list={["mobile-nav-item", currentPath === "/tasks" && "active"]}
    href="/tasks/"
    aria-current={currentPath === "/tasks" ? "page" : undefined}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m5 12 4 4L19 6" />
      <path d="M19 12v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8" />
    </svg>
    <span>Tasks</span>
  </a>
  <a
    class:list={["mobile-nav-item", currentSection === "Projects" && "active"]}
    href="/projects/"
    aria-current={currentSection === "Projects" ? "page" : undefined}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3.5 7.5h7l2 2h8v9a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" />
      <path d="M3.5 7.5v-2a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v2" />
    </svg>
    <span>Projects</span>
  </a>
  <a
    class:list={["mobile-nav-item", currentPath === "/calendar" && "active"]}
    href="/calendar/"
    aria-current={currentPath === "/calendar" ? "page" : undefined}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3.5" y="5" width="17" height="15.5" rx="2" />
      <path d="M7.5 3.5v3M16.5 3.5v3M3.5 9.5h17M8 13h.01M12 13h.01M16 13h.01M8 16.5h.01M12 16.5h.01" />
    </svg>
    <span>Calendar</span>
  </a>
  <a
    class:list={["mobile-nav-item", currentPath === "/profile" && "active"]}
    href="/profile/"
    aria-current={currentPath === "/profile" ? "page" : undefined}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="3.5" />
      <path d="M5 20a7 7 0 0 1 14 0" />
    </svg>
    <span>Profile</span>
  </a>
</nav>

<style>
  .mobile-app-header,
  .mobile-bottom-nav {
    display: none;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    width: 250px;
    padding: 28px 18px 18px;
    background: #11131c;
    border-right: 1px solid #252937;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 0 8px;
  }

  .brand-icon {
    display: grid;
    width: 35px;
    height: 35px;
    place-items: center;
    border-radius: 10px;
    color: white;
    background: #8b7cff;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 21px;
    font-weight: 800;
  }

  .brand-name {
    color: #f0f0f7;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -1px;
  }

  .brand-name span {
    color: #9b8dff;
  }

  .workspace {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 36px;
    padding: 12px 10px;
    border: 1px solid #292d3c;
    border-radius: 10px;
    background: #181b26;
  }

  .workspace-avatar {
    display: grid;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 8px;
    color: #c8c0ff;
    background: #302b50;
    font-weight: 700;
  }

  .workspace-info,
  .user-info {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
  }

  .workspace-info strong,
  .user-info strong {
    overflow: hidden;
    color: #e8eaf0;
    font-size: 12px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .workspace-info > span,
  .user-info > span {
    color: #858b9d;
    font-size: 11px;
  }

  .workspace-menu {
    color: #858b9d;
  }

  .nav-section {
    margin-top: 35px;
  }

  .nav-label {
    margin: 0 10px 12px;
    color: #777e91;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .navigation {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .nav-item {
    display: flex;
    min-height: 43px;
    align-items: center;
    gap: 12px;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #9ba1b2;
    font-size: 13px;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .nav-item:hover {
    color: #e8eaf0;
    background: #1b1e2b;
  }

  .nav-item.active {
    border-color: #35304f;
    color: #bcb2ff;
    background: #242038;
  }

  .nav-icon {
    width: 18px;
    font-size: 17px;
    text-align: center;
  }

  .nav-count {
    margin-left: auto;
    color: #8d93a5;
    font-size: 11px;
  }

  .sidebar-bottom {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding: 18px 8px 8px;
    border-top: 1px solid #292d3c;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .sidebar-bottom:hover {
    background: #1b1e2b;
  }

  .sidebar-bottom.profile-active {
    background: #242038;
  }

  .sidebar-bottom.profile-active .user-info strong {
    color: #bcb2ff;
  }

  .sidebar-bottom .user-info {
    flex: 1;
    min-width: 0;
  }

  .user-avatar {
    display: grid;
    width: 35px;
    height: 35px;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid #514780;
    border-radius: 50%;
    color: #d6d0ff;
    background: #302b50;
    font-size: 11px;
    font-weight: 700;
  }

  .user-menu {
    border: 0;
    color: #969caf;
    background: transparent;
    font-size: 20px;
  }

  .user-menu-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .user-menu {
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 6px;
  }

  .user-menu:hover {
    background: #252937;
  }

  .user-dropdown {
    position: absolute;
    right: 0;
    bottom: calc(100% + 8px);
    z-index: 20;
    min-width: 150px;
    padding: 5px;
    border: 1px solid #353a4b;
    border-radius: 9px;
    background: #1b1e2b;
    box-shadow: 0 10px 30px rgb(0 0 0 / 25%);
  }

  .user-dropdown[hidden] {
    display: none;
  }

  .user-dropdown-item {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 9px;
    padding: 10px 12px;
    border: 0;
    border-radius: 6px;
    color: #e8eaf0;
    background: transparent;
    text-align: left;
    text-decoration: none;
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  .user-dropdown-item:hover {
    background: #302b50;
    color: #c8c0ff;
  }

  .user-dropdown .logout-option {
    color: #ff9b9b;
  }

  .user-dropdown .logout-option:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  @media (max-width: 760px) {
    .mobile-app-header {
      position: fixed;
      inset: 0 0 auto;
      z-index: 1002;
      display: flex;
      height: calc(58px + env(safe-area-inset-top));
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: env(safe-area-inset-top) 18px 0;
      border-bottom: 1px solid #252937;
      background: rgb(17 19 28 / 96%);
      backdrop-filter: blur(16px);
    }

    .mobile-brand {
      display: flex;
      align-items: center;
      gap: 9px;
      color: #f0f0f7;
      font-family: "Plus Jakarta Sans", sans-serif;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.4px;
    }

    .mobile-brand-icon {
      display: grid;
      width: 30px;
      height: 30px;
      place-items: center;
      border-radius: 9px;
      color: #fff;
      background: #7668f5;
      font-size: 18px;
    }

    .mobile-page-title {
      margin-left: auto;
      color: #aeb4c3;
      font-size: 12px;
      font-weight: 600;
    }

    .sidebar {
      display: none;
    }

    .mobile-bottom-nav {
      position: fixed;
      inset: auto 0 0;
      z-index: 1002;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      min-height: calc(64px + env(safe-area-inset-bottom));
      padding: 7px 8px calc(7px + env(safe-area-inset-bottom));
      border-top: 1px solid #292d3c;
      background: rgb(17 19 28 / 97%);
      backdrop-filter: blur(16px);
    }

    .mobile-nav-item {
      display: flex;
      min-width: 0;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 4px;
      border-radius: 10px;
      color: #858b9d;
      font-size: 9px;
      font-weight: 600;
      text-decoration: none;
      transition:
        color 0.18s ease,
        background-color 0.18s ease;
    }

    .mobile-nav-item svg {
      width: 21px;
      height: 21px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.7;
    }

    .mobile-nav-item.active {
      color: #bcb2ff;
      background: #242038;
    }

    .mobile-nav-item:focus-visible {
      outline: 2px solid #a195ff;
      outline-offset: -2px;
    }
  }
</style>

<script>
  import { Capacitor } from "@capacitor/core";
  import { supabase } from "../lib/supabase";

  const swipeRoutes = ["/", "/tasks/", "/projects/", "/calendar/", "/profile/"];
  const currentPath = window.location.pathname
    .replace(/index\.html$/, "")
    .replace(/\/$/, "") || "/";
  const currentRoute =
    currentPath === "/project" ? "/projects" : currentPath;
  const currentRouteIndex = swipeRoutes.findIndex(
    (route) => (route === "/" ? "/" : route.replace(/\/$/, "")) === currentRoute,
  );
  let touchStart: {
    x: number;
    y: number;
    scrollElement: HTMLElement | null;
    scrollLeft: number;
  } | null = null;

  function isSwipeExcluded(target: EventTarget | null): boolean {
    if (!(target instanceof Element)) return true;
    if (
      target.closest(
        "a, button, input, textarea, select, [contenteditable='true'], [role='dialog'], [data-no-swipe]",
      )
    ) {
      return true;
    }

    return false;
  }

  function getHorizontalScrollElement(
    target: EventTarget | null,
  ): HTMLElement | null {
    if (!(target instanceof Element)) return null;

    for (
      let element: HTMLElement | null =
        target instanceof HTMLElement ? target : target.parentElement;
      element;
      element = element.parentElement
    ) {
      const overflowX = window.getComputedStyle(element).overflowX;
      if (
        element.scrollWidth > element.clientWidth &&
        (overflowX === "auto" || overflowX === "scroll")
      ) {
        return element;
      }
    }

    return null;
  }

  if (Capacitor.isNativePlatform()) {
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((link) => {
      const url = new URL(link.href, window.location.href);
      if (url.pathname !== "/" && url.pathname.endsWith("/")) {
        url.pathname += "index.html";
        link.href = `${url.pathname}${url.search}${url.hash}`;
      }
    });

    document.addEventListener(
      "touchstart",
      (event) => {
        if (
          !window.matchMedia("(max-width: 760px)").matches ||
          event.touches.length !== 1 ||
          isSwipeExcluded(event.target)
        ) {
          touchStart = null;
          return;
        }

        const touch = event.touches[0];
        if (touch.clientX < 24 || touch.clientX > window.innerWidth - 24) {
          touchStart = null;
          return;
        }

        const scrollElement = getHorizontalScrollElement(event.target);
        touchStart = {
          x: touch.clientX,
          y: touch.clientY,
          scrollElement,
          scrollLeft: scrollElement?.scrollLeft ?? 0,
        };
      },
      { passive: true },
    );

    document.addEventListener(
      "touchend",
      (event) => {
        if (!touchStart || event.changedTouches.length !== 1) {
          touchStart = null;
          return;
        }

        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchStart.x;
        const deltaY = touch.clientY - touchStart.y;
        const horizontalScrollChanged =
          touchStart.scrollElement &&
          Math.abs(touchStart.scrollElement.scrollLeft - touchStart.scrollLeft) > 2;
        touchStart = null;

        if (
          horizontalScrollChanged ||
          Math.abs(deltaX) < 80 ||
          Math.abs(deltaY) > 60
        ) {
          return;
        }

        const nextRouteIndex =
          currentRouteIndex + (deltaX < 0 ? 1 : -1);
        const nextRoute = swipeRoutes[nextRouteIndex];
        const nativeRoute =
          nextRoute && nextRoute !== "/" ? `${nextRoute}index.html` : nextRoute;
        if (nativeRoute) window.location.assign(nativeRoute);
      },
      { passive: true },
    );

    document.addEventListener(
      "touchcancel",
      () => {
        touchStart = null;
      },
      { passive: true },
    );
  }

  const userNameElement = document.querySelector<HTMLElement>("#user-name");
  const userAvatarElement = document.querySelector<HTMLElement>("#user-avatar");

  supabase.auth.onAuthStateChange((event) => {
    if (event === "SIGNED_OUT") {
      window.dispatchEvent(new Event("devtask:clear-page-cache"));
    }
  });

  async function loadUserProfile() {
    const { data, error } = await supabase.auth.getUser();

    const user = error ? null : data.user;

    const displayName = user
      ? user.user_metadata?.full_name ||
        user.user_metadata?.name ||
        user.email?.split("@")[0] ||
        "User"
      : "Sign in";

    if (userNameElement) {
      userNameElement.textContent = displayName;
    }

    const initials = displayName
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part: string) => part.charAt(0).toUpperCase())
      .join("");
    if (userAvatarElement) userAvatarElement.textContent = initials;
    if (userAvatarElement) userAvatarElement.textContent = initials;
  }

  loadUserProfile();
</script>
