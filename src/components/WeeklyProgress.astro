---
const days = [
  { day: "Mon", completed: 4, created: 2 },
  { day: "Tue", completed: 6, created: 3 },
  { day: "Wed", completed: 3, created: 4 },
  { day: "Thu", completed: 7, created: 2 },
  { day: "Fri", completed: 5, created: 3 },
  { day: "Sat", completed: 2, created: 1 },
  { day: "Sun", completed: 4, created: 2 },
];

const maxValue = 8;
---

<section class="weekly-panel">
  <div class="panel-heading">
    <div>
      <h2>Weekly activity</h2>
      <p>Track your productivity throughout the week.</p>
    </div>

    <span class="period-label">Last 7 days</span>
  </div>

  <div class="chart-legend">
    <span><i class="legend-dot completed"></i>Completed</span>
    <span><i class="legend-dot created"></i>Created</span>
  </div>

  <div class="chart">
    {days.map((item) => (
      <div class="chart-column">
        <div class="bar-area">
          <div
            class="bar completed-bar"
            style={`height: ${(item.completed / maxValue) * 100}%`}
            title={`${item.completed} completed`}
          ></div>

          <div
            class="bar created-bar"
            style={`height: ${(item.created / maxValue) * 100}%`}
            title={`${item.created} created`}
          ></div>
        </div>

        <span class="day-label">{item.day}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .weekly-panel {
    min-width: 0;
    padding: 24px;
    border: 1px solid #292e3d;
    border-radius: 13px;
    background: #131620;
  }

  .panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .panel-heading h2 {
    margin: 0;
    color: #e8eaf0;
    font-size: 15px;
    font-weight: 700;
  }

  .panel-heading p {
    margin: 7px 0 0;
    color: #858c9e;
    font-size: 12px;
    line-height: 1.7;
  }

  .period-label {
    padding: 8px 10px;
    border: 1px solid #292e3d;
    border-radius: 7px;
    color: #aeb4c3;
    font-size: 11px;
    white-space: nowrap;
  }

  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 27px;
  }

  .chart-legend > span {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #a4aabb;
    font-size: 11px;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 3px;
  }

  .legend-dot.completed {
    background: #8b7cff;
  }

  .legend-dot.created {
    background: #4d5268;
  }

  .chart {
    display: grid;
    height: 205px;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 12px;
    margin-top: 25px;
    border-bottom: 1px solid #292e3d;
  }

  .chart-column {
    display: flex;
    min-width: 0;
    align-items: center;
    flex-direction: column;
    justify-content: flex-end;
  }

  .bar-area {
    display: flex;
    width: 100%;
    height: 170px;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
  }

  .bar {
    width: min(19px, 40%);
    min-height: 4px;
    border-radius: 5px 5px 0 0;
    transition: height 0.3s ease;
  }

  .completed-bar {
    background: linear-gradient(180deg, #a69aff, #7969e9);
  }

  .created-bar {
    background: #41465b;
  }

  .day-label {
    padding: 10px 0;
    color: #858c9e;
    font-size: 10px;
  }

  @media (max-width: 480px) {
    .weekly-panel {
      padding: 18px;
    }

    .chart {
      gap: 5px;
    }

    .bar-area {
      gap: 3px;
    }

    .period-label {
      font-size: 10px;
    }
  }
</style>